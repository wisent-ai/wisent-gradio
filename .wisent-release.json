{
  "schema_version": 1,
  "product": "wisent-gradio",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "setup.py",
    "pattern": "(?m)^\\s*version=\"(?P<version>[0-9A-Za-z.+-]+)\",$"
  },
  "platforms": {
    "python-package": {
      "runner_platform": "linux-amd64",
      "quality": [],
      "build": {
        "argv": ["stado", "product", "python", "build"]
      },
      "stage": {
        "release/python-distributions.tar": "release/python-distributions.tar"
      }
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "pypi",
      "platform": "python-package",
      "argv": ["stado", "product", "python", "deliver-pypi"],
      "required": true,
      "secret_env": {
        "PYPI_TOKEN": "pypi#token"
      }
    }
  ]
}
